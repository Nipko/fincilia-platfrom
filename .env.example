# Synthetic local development only. Copy to .env and keep it untracked.
# Toda variable declarada aqui existe en docs/platform/runtime-config.json;
# el validador falla si una de las dos listas se mueve sin la otra.
FINCILIA_AI_GATEWAY_ENABLED=false
FINCILIA_API_BASE_URL=http://api:8000
FINCILIA_AUTH_AUDIENCE=fincilia-api
FINCILIA_AUTH_ISSUER=fincilia-local
FINCILIA_AUTH_SIGNING_KEY=set_in_untracked_local_env
FINCILIA_AUTHORIZATION_CONTEXT_HMAC_KEY=set_in_untracked_local_env
FINCILIA_AUTH_TOKEN_TTL_SECONDS=900
FINCILIA_BUILD_REVISION=development
FINCILIA_CACHE_URL=redis://valkey:6379/0
FINCILIA_DATABASE_POOL_MAX=8
FINCILIA_DATABASE_POOL_MIN=1
FINCILIA_DATABASE_STATEMENT_TIMEOUT_MS=15000
FINCILIA_DATABASE_URL=set_in_untracked_local_env
FINCILIA_ENGINE_RELEASE_KEY=fnc-p3-mapping-0.1.0
FINCILIA_ENV=local
FINCILIA_IDENTIFIER_KEY_VERSION=1
FINCILIA_IDENTIFIER_TOKENIZATION_KEY=set_in_untracked_local_env
FINCILIA_LOG_LEVEL=info
FINCILIA_OBJECT_ACCESS_KEY=set_in_untracked_local_env
FINCILIA_OBJECT_BUCKET_DERIVED=fincilia-derived
FINCILIA_OBJECT_BUCKET_EXPORTS=fincilia-exports
FINCILIA_OBJECT_BUCKET_QUARANTINE=fincilia-quarantine
FINCILIA_OBJECT_BUCKET_RAW=fincilia-raw
FINCILIA_OBJECT_REGION=us-east-1
FINCILIA_OBJECT_SECRET_KEY=set_in_untracked_local_env
FINCILIA_OBJECT_STORE_ENDPOINT=disabled
FINCILIA_OTEL_ENDPOINT=disabled
FINCILIA_PAYMENTS_ENABLED=false
FINCILIA_REAL_DATA_ENABLED=false
FINCILIA_RELEASE_ID=unreleased
FINCILIA_SERVICE_NAME=fincilia-api
FINCILIA_WEB_SECURE_COOKIES=false
