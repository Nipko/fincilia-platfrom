name: fincilia-beta

x-logs: &bounded-logs
  driver: json-file
  options:
    max-size: "10m"
    max-file: "3"

services:
  postgres:
    image: postgres:17.11-alpine3.24@sha256:18cfe3ef5e6815560c98237d6216d1e5119702fb0f3894c8785dd58b8bbe5d73
    environment:
      POSTGRES_DB: fincilia_beta
      POSTGRES_USER: fincilia_beta_admin
      POSTGRES_PASSWORD: $${FINCILIA_DB_ADMIN_PASSWORD}
      POSTGRES_INITDB_ARGS: "--auth-host=scram-sha-256 --auth-local=trust"
      FINCILIA_DB_APP_PASSWORD: $${FINCILIA_DB_APP_PASSWORD}
      FINCILIA_DB_MIGRATOR_PASSWORD: $${FINCILIA_DB_MIGRATOR_PASSWORD}
      FINCILIA_DB_WORKER_PASSWORD: $${FINCILIA_DB_WORKER_PASSWORD}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U fincilia_beta_admin -d fincilia_beta"]
      interval: 3s
      timeout: 3s
      retries: 40
      start_period: 8s
    stop_grace_period: 45s
    restart: unless-stopped
    mem_limit: 512m
    security_opt: ["no-new-privileges:true"]
    volumes:
      - pgdata:/var/lib/postgresql/data
      - ./bootstrap.sh:/docker-entrypoint-initdb.d/001_bootstrap.sh:ro
    networks: [private]
    logging: *bounded-logs

  valkey:
    image: valkey/valkey:8.1-alpine@sha256:e0eb7c480958d32bdc4357a74bdd70653ae15f2f9b4c93c4a5a9fad1dc471c84
    command: ["valkey-server", "--save", "", "--appendonly", "no", "--maxmemory", "64mb", "--maxmemory-policy", "allkeys-lru"]
    healthcheck:
      test: ["CMD-SHELL", "valkey-cli ping | grep -q PONG"]
      interval: 3s
      timeout: 3s
      retries: 30
    restart: unless-stopped
    mem_limit: 96m
    read_only: true
    security_opt: ["no-new-privileges:true"]
    tmpfs: ["/data"]
    networks: [private]
    logging: *bounded-logs

  objectstore:
    image: minio/minio:RELEASE.2025-04-22T22-12-26Z@sha256:a1ea29fa28355559ef137d71fc570e508a214ec84ff8083e39bc5428980b015e
    command: ["server", "/data"]
    environment:
      MINIO_ROOT_USER: $${FINCILIA_OBJECT_ACCESS_KEY}
      MINIO_ROOT_PASSWORD: $${FINCILIA_OBJECT_SECRET_KEY}
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://localhost:9000/minio/health/live || exit 1"]
      interval: 3s
      timeout: 3s
      retries: 40
      start_period: 8s
    restart: unless-stopped
    mem_limit: 256m
    security_opt: ["no-new-privileges:true"]
    volumes: ["objectdata:/data"]
    networks: [private]
    logging: *bounded-logs

  api:
    image: ${api_image}
    environment:
      FINCILIA_ENV: test
      FINCILIA_LOG_LEVEL: info
      FINCILIA_BUILD_REVISION: ${release_sha}
      FINCILIA_RELEASE_ID: fnc-beta-${release_sha}
      FINCILIA_OTEL_ENDPOINT: disabled
      FINCILIA_DATABASE_URL: postgresql://fincilia_app:$${FINCILIA_DB_APP_PASSWORD}@postgres:5432/fincilia_beta
      FINCILIA_DATABASE_POOL_MIN: "1"
      FINCILIA_DATABASE_POOL_MAX: "4"
      FINCILIA_DATABASE_STATEMENT_TIMEOUT_MS: "15000"
      FINCILIA_CACHE_URL: redis://valkey:6379/0
      FINCILIA_OBJECT_STORE_ENDPOINT: http://objectstore:9000
      FINCILIA_OBJECT_REGION: sa-east-1
      FINCILIA_OBJECT_ACCESS_KEY: $${FINCILIA_OBJECT_ACCESS_KEY}
      FINCILIA_OBJECT_SECRET_KEY: $${FINCILIA_OBJECT_SECRET_KEY}
      FINCILIA_AUTH_ISSUER: fincilia-closed-beta
      FINCILIA_AUTH_AUDIENCE: fincilia-api
      FINCILIA_AUTH_SIGNING_KEY: $${FINCILIA_AUTH_SIGNING_KEY}
      FINCILIA_AUTH_TOKEN_TTL_SECONDS: "900"
      FINCILIA_AUTHORIZATION_CONTEXT_HMAC_KEY: $${FINCILIA_AUTHORIZATION_CONTEXT_HMAC_KEY}
      FINCILIA_IDENTIFIER_TOKENIZATION_KEY: $${FINCILIA_IDENTIFIER_TOKENIZATION_KEY}
      FINCILIA_IDENTIFIER_KEY_VERSION: "1"
      FINCILIA_REAL_DATA_ENABLED: "false"
      FINCILIA_AI_GATEWAY_ENABLED: "false"
      FINCILIA_PAYMENTS_ENABLED: "false"
      FINCILIA_REGISTRATION_INVITE_REQUIRED: "true"
    healthcheck:
      test: ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://localhost:8000/health/live', timeout=3)\""]
      interval: 4s
      timeout: 5s
      retries: 40
      start_period: 10s
    restart: unless-stopped
    mem_limit: 384m
    read_only: true
    security_opt: ["no-new-privileges:true"]
    tmpfs: ["/tmp"]
    depends_on:
      postgres: {condition: service_healthy}
      valkey: {condition: service_healthy}
      objectstore: {condition: service_healthy}
    networks: [private]
    logging: *bounded-logs

  worker:
    image: ${worker_image}
    environment:
      FINCILIA_ENV: test
      FINCILIA_LOG_LEVEL: info
      FINCILIA_SERVICE_NAME: fincilia-worker
      FINCILIA_BUILD_REVISION: ${release_sha}
      FINCILIA_RELEASE_ID: fnc-beta-${release_sha}
      FINCILIA_DATABASE_URL: postgresql://fincilia_worker:$${FINCILIA_DB_WORKER_PASSWORD}@postgres:5432/fincilia_beta
      FINCILIA_DATABASE_POOL_MIN: "1"
      FINCILIA_DATABASE_POOL_MAX: "2"
      FINCILIA_CACHE_URL: redis://valkey:6379/1
      FINCILIA_OBJECT_STORE_ENDPOINT: http://objectstore:9000
      FINCILIA_OBJECT_REGION: sa-east-1
      FINCILIA_OBJECT_ACCESS_KEY: $${FINCILIA_OBJECT_ACCESS_KEY}
      FINCILIA_OBJECT_SECRET_KEY: $${FINCILIA_OBJECT_SECRET_KEY}
      FINCILIA_REAL_DATA_ENABLED: "false"
      FINCILIA_AI_GATEWAY_ENABLED: "false"
    healthcheck:
      test: ["CMD-SHELL", "test -f /tmp/fincilia-worker-alive && find /tmp/fincilia-worker-alive -mmin -1 | grep -q ."]
      interval: 5s
      timeout: 3s
      retries: 30
      start_period: 10s
    restart: unless-stopped
    mem_limit: 320m
    read_only: true
    security_opt: ["no-new-privileges:true"]
    tmpfs: ["/tmp"]
    depends_on:
      postgres: {condition: service_healthy}
      valkey: {condition: service_healthy}
      objectstore: {condition: service_healthy}
    networks: [private]
    logging: *bounded-logs

  migrate:
    profiles: ["migrate"]
    image: ${api_image}
    command: ["python", "-m", "db.migrate.apply", "--dsn", "postgresql://fincilia_migrator:$${FINCILIA_DB_MIGRATOR_PASSWORD}@postgres:5432/fincilia_beta"]
    environment:
      FINCILIA_MIGRATOR_URL: postgresql://fincilia_migrator:$${FINCILIA_DB_MIGRATOR_PASSWORD}@postgres:5432/fincilia_beta
      FINCILIA_DATABASE_URL: postgresql://fincilia_app:$${FINCILIA_DB_APP_PASSWORD}@postgres:5432/fincilia_beta
      FINCILIA_WORKER_URL: postgresql://fincilia_worker:$${FINCILIA_DB_WORKER_PASSWORD}@postgres:5432/fincilia_beta
      FINCILIA_CACHE_URL: redis://valkey:6379/3
      FINCILIA_AUTH_SIGNING_KEY: $${FINCILIA_AUTH_SIGNING_KEY}
      FINCILIA_AUTHORIZATION_CONTEXT_HMAC_KEY: $${FINCILIA_AUTHORIZATION_CONTEXT_HMAC_KEY}
      FINCILIA_IDENTIFIER_TOKENIZATION_KEY: $${FINCILIA_IDENTIFIER_TOKENIZATION_KEY}
      FINCILIA_OBJECT_STORE_ENDPOINT: http://objectstore:9000
      FINCILIA_OBJECT_REGION: sa-east-1
      FINCILIA_OBJECT_ACCESS_KEY: $${FINCILIA_OBJECT_ACCESS_KEY}
      FINCILIA_OBJECT_SECRET_KEY: $${FINCILIA_OBJECT_SECRET_KEY}
      FINCILIA_REAL_DATA_ENABLED: "false"
      FINCILIA_AI_GATEWAY_ENABLED: "false"
      FINCILIA_PAYMENTS_ENABLED: "false"
    depends_on: {postgres: {condition: service_healthy}}
    read_only: true
    security_opt: ["no-new-privileges:true"]
    tmpfs: ["/tmp"]
    networks: [private]
    logging: *bounded-logs

  web:
    image: ${web_image}
    environment:
      FINCILIA_ENV: test
      FINCILIA_API_BASE_URL: http://api:8000
      FINCILIA_WEB_SECURE_COOKIES: "true"
      FINCILIA_PUBLIC_STAGE: closed_beta
      FINCILIA_REGISTRATION_INVITE_REQUIRED: "true"
      NEXT_TELEMETRY_DISABLED: "1"
    healthcheck:
      test: ["CMD-SHELL", "node -e \"require('http').get('http://localhost:3000/entrar',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))\""]
      interval: 4s
      timeout: 5s
      retries: 40
      start_period: 10s
    restart: unless-stopped
    mem_limit: 256m
    read_only: true
    security_opt: ["no-new-privileges:true"]
    tmpfs: ["/tmp"]
    depends_on: {api: {condition: service_healthy}}
    networks: [private, frontend]
    logging: *bounded-logs

  nginx:
    image: nginx:1.29.1-alpine@sha256:42a516af16b852e33b7682d5ef8acbd5d13fe08fecadc7ed98605ba5e3b26ab8
    volumes: ["./nginx.conf:/etc/nginx/nginx.conf:ro"]
    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider http://127.0.0.1:8080/entrar"]
      interval: 5s
      timeout: 4s
      retries: 30
      start_period: 10s
    restart: unless-stopped
    mem_limit: 64m
    read_only: true
    security_opt: ["no-new-privileges:true"]
    tmpfs: ["/var/cache/nginx", "/var/run", "/tmp"]
    depends_on: {web: {condition: service_healthy}}
    networks: [frontend]
    logging: *bounded-logs

  caddy:
    image: caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
    ports: ["80:80", "443:443"]
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    restart: unless-stopped
    mem_limit: 96m
    read_only: true
    security_opt: ["no-new-privileges:true"]
    tmpfs: ["/tmp"]
    depends_on: {nginx: {condition: service_healthy}}
    networks: [frontend, edge]
    logging: *bounded-logs

volumes:
  pgdata:
  objectdata:
  caddy_data:
  caddy_config:

networks:
  private: {internal: true}
  frontend: {internal: true}
  edge:
