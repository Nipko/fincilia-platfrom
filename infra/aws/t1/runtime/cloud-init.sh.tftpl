#!/usr/bin/env bash
set -euo pipefail

dnf install -y docker openssl
systemctl enable --now docker

install -d -m 0755 /usr/local/lib/docker/cli-plugins
curl -fsSLo /usr/local/lib/docker/cli-plugins/docker-compose \
  https://github.com/docker/compose/releases/download/v${compose_version}/docker-compose-linux-x86_64
printf '%s  %s\n' '${compose_sha256}' /usr/local/lib/docker/cli-plugins/docker-compose | sha256sum -c -
chmod 0755 /usr/local/lib/docker/cli-plugins/docker-compose

install -d -m 0700 /opt/fincilia
aws s3 cp '${bundle_uri}/' /opt/fincilia/ --recursive --only-show-errors
cd /opt/fincilia
sha256sum -c manifest.sha256
chmod 0700 up.sh
# La imagen oficial ejecuta los scripts de init como el usuario postgres. El
# fichero solo contiene credenciales sinteticas versionadas; debe ser legible
# dentro del bind mount, mientras runtime.env conserva los secretos 0600.
chmod 0444 bootstrap.sql
install -m 0644 fincilia-t1.service /etc/systemd/system/fincilia-t1.service
install -m 0644 fincilia-t1-autostop.service /etc/systemd/system/fincilia-t1-autostop.service
install -m 0644 fincilia-t1-autostop.timer /etc/systemd/system/fincilia-t1-autostop.timer

aws ecr get-login-password --region sa-east-1 | \
  docker login --username AWS --password-stdin '${registry}'
docker compose --env-file /dev/null -f /opt/fincilia/compose.yaml pull

systemctl daemon-reload
# El limite de costo debe quedar armado aunque el servicio de aplicacion falle.
systemctl enable --now fincilia-t1-autostop.timer
systemctl enable --now fincilia-t1.service
