  "checkpoint_contract": {
    "entity": "dataset_chunk",
    "owner_module": "clean",
    "work_class": "stateless_job",
    "company_scoped": true,
    "rationale": "Publicar cien mil movimientos no cabe en una transaccion, asi que se hace por tramos. El punto de control dice que tramos ya ocurrieron: sin el, reintentar seria duplicar, y volver a empezar seria la unica alternativa segura.",
    "required_fields": ["chunk_id", "chunk_ordinal", "company_id", "completed_at", "dataset_version_id", "first_record", "last_record", "movement_count", "rejected_count"],
    "checkpoint_and_effect_transaction": "same_transaction",
    "checkpoint_reserved_before_effect": true,
    "checkpoint_authority": "postgresql",
    "valkey_may_hold": "progress_percentage_for_the_screen_only",
    "valkey_is_checkpoint_authority": false,
    "valkey_loss_effect": "progress_bar_resets_no_chunk_is_repeated_or_lost",
    "retry_owner": "worker_job_runner",
    "broker_redelivery_is_not_extra_owner": true,
    "resume_semantics": "skip_recorded_ordinals_and_continue",
    "duplicate_ordinal": "unique_violation_is_the_signal_the_chunk_already_ran",
    "concurrent_writers": "the_second_one_collides_on_the_ordinal_before_doing_work",
    "partial_chunk": "rolled_back_whole_never_half_written",
    "states": ["absent", "recorded"],
    "financial_state_authority": false,
    "lineage_authority": false,
    "dead_letter_on_exhaustion": true,
    "invariants": [
      {"id": "CHK-SAME-TRANSACTION", "rule": "El punto de control y los movimientos del tramo se confirman juntos. Un recibo sin su efecto mentiria, y un efecto sin recibo se repetiria."},
      {"id": "CHK-RESERVED-BEFORE-EFFECT", "rule": "La fila del tramo se inserta antes de escribir el lote: quien llegue segundo choca con el ordinal antes de trabajar, no despues."},
      {"id": "CHK-POSTGRESQL-AUTHORITY", "rule": "El punto de control vive en PostgreSQL. Valkey guarda como va la barra de progreso y nada mas."},
      {"id": "CHK-VALKEY-NEVER-AUTHORITY", "rule": "Perder Valkey no repite ni pierde un tramo: la reanudacion lee los ordinales confirmados, no la cache."},
      {"id": "CHK-ONE-RETRY-OWNER", "rule": "El reintento lo posee el ejecutor del trabajo. La reentrega del broker no anade un segundo dueno."},
      {"id": "CHK-IDEMPOTENT-RESUME", "rule": "Reanudar salta los ordinales ya confirmados. El recuento final y el digest son los mismos que en una corrida entera."},
      {"id": "CHK-NOT-FINANCIAL", "rule": "Un tramo no es un hecho economico ni una etapa de linaje: cuenta cuanto se publico, no que se publico."},
      {"id": "CHK-EXHAUSTION-VISIBLE", "rule": "Agotados los intentos, la publicacion incompleta va a la cola de fallidos con su ultimo ordinal, no se marca completa."}
    ]
  },
  "required_tests": [
    {"id": "TST-OUT-001", "scenario": "domain and outbox atomic commit and rollback"},
    {"id": "TST-OUT-002", "scenario": "crash after commit before publish is recovered"},
    {"id": "TST-OUT-003", "scenario": "duplicate delivery creates one visible consumer effect"},
    {"id": "TST-OUT-004", "scenario": "same event id with different digest conflicts"},
    {"id": "TST-OUT-005", "scenario": "consumer crash rolls back receipt and effect together"},
    {"id": "TST-RET-001", "scenario": "exactly one retry schedule owner per work class"},
    {"id": "TST-RET-002", "scenario": "adapter and circuit breaker never schedule retry"},
    {"id": "TST-RET-003", "scenario": "attempt time cost and deadline budget exhaustion"},
    {"id": "TST-RET-004", "scenario": "stale fencing token cannot publish"},
    {"id": "TST-RET-005", "scenario": "provider retry-after cannot exceed budget"},
    {"id": "TST-DLQ-001", "scenario": "exhausted work becomes visible minimized dead letter"},
    {"id": "TST-DLQ-002", "scenario": "replay reauthorizes and preserves idempotency key"},
    {"id": "TST-DLQ-003", "scenario": "discard requires reason actor and audit"},
    {"id": "TST-ORD-001", "scenario": "out-of-order aggregate gap pauses effect"},
    {"id": "TST-SCH-001", "scenario": "unknown or incompatible schema has no effect"},
    {"id": "TST-EXT-001", "scenario": "unknown non-idempotent external outcome is not retried"},
    {"id": "TST-EXE-001", "scenario": "Valkey loss does not lose domain or retry state"},
    {"id": "TST-EXE-002", "scenario": "workflow history cannot become financial authority"},
    {"id": "TST-CHK-001", "scenario": "chunk checkpoint and its movements commit or roll back together"},
    {"id": "TST-CHK-002", "scenario": "resume after a failure between two chunks writes no duplicate"},
    {"id": "TST-CHK-003", "scenario": "losing the progress cache changes neither the count nor the digest"},
    {"id": "TST-AUTH-001", "scenario": "revoked authorization blocks pending publish and replay"},
    {"id": "TST-TEN-002", "scenario": "event or dead letter cannot cross company scope"}
  ],
  "dependencies": ["FNC-ARC-001", "FNC-ARC-002", "FNC-DOM-004", "FNC-SEC-001", "FNC-SEC-002", "FNC-PLT-001"],
