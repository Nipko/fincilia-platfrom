{
  "schema_version": 1,
  "task_id": "FNC-ARC-004",
  "status": "review_pending",
  "human_acceptance": "pending",
  "data_ceiling": "synthetic_only",
  "provider_selection": "pending_human",
  "principles": [
    {"id": "EVT-DOMAIN-FIRST", "rule": "Events communicate committed facts and never complete an invariant that belongs in the originating transaction."},
    {"id": "EVT-AT-LEAST-ONCE", "rule": "Transport is at-least-once and consumers make visible effects idempotent."},
    {"id": "EVT-OUTBOX-ATOMIC", "rule": "Domain change and outbox record commit in one PostgreSQL transaction."},
    {"id": "EVT-INBOX-ATOMIC", "rule": "Consumer receipt and local effect commit atomically or neither commits."},
    {"id": "EVT-NO-GLOBAL-ORDER", "rule": "No consumer assumes global delivery order; aggregate version detects gaps and stale events."},
    {"id": "RET-ONE-OWNER", "rule": "Every retryable unit has exactly one durable retry schedule owner."},
    {"id": "RET-BOUNDED", "rule": "Attempts, elapsed time, per-attempt timeout, cost and deadline are bounded by a versioned policy."},
    {"id": "RET-ADAPTER-CLASSIFIES", "rule": "Adapters classify failure and fail fast; they do not run independent retry loops."},
    {"id": "DLQ-VISIBLE", "rule": "Exhausted or unsafe work becomes a visible, scoped and auditable dead-letter item."},
    {"id": "EXT-NO-BLIND-RETRY", "rule": "An external effect without verified provider idempotency is never retried blindly."},
    {"id": "EXE-SEPARATE-TRUTHS", "rule": "PostgreSQL owns visible domain state, durable workflow owns execution history and Valkey owns neither."},
    {"id": "EVT-MINIMIZED", "rule": "Messages and telemetry carry minimized versioned data; secret or prohibited data is forbidden."}
  ],
  "owned_entities": [
    {"id": "outbox_event", "owner_module": "platform"},
    {"id": "inbox_receipt", "owner_module": "platform"},
    {"id": "job_definition", "owner_module": "platform"},
    {"id": "delivery_attempt", "owner_module": "platform"},
    {"id": "dead_letter_item", "owner_module": "platform"}
  ],
