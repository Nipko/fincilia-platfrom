{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fincilia.local/common/origin-reference.v1.schema.json",
  "title": "Fincilia Origin Reference v1",
  "type": "object",
  "required": ["artifact_id", "version_id", "sha256", "locator"],
  "properties": {
    "artifact_id": { "type": "string", "format": "uuid" },
    "version_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "locator": {
      "type": "object",
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "sheet": { "type": "string", "maxLength": 128 },
        "row": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "cell": { "type": "string", "maxLength": 32 },
        "xml_path": { "type": "string", "maxLength": 1024 },
        "record_id": { "type": "string", "maxLength": 256 },
        "bounding_box": {
          "type": "array",
          "items": { "type": "number", "minimum": 0 },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    }
  },
  "additionalProperties": false
}

