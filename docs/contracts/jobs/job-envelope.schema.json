{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fincilia.local/jobs/job-envelope.v1.schema.json",
  "title": "Fincilia Job Envelope v1",
  "type": "object",
  "required": [
    "job_id",
    "job_kind",
    "schema_version",
    "company_id",
    "cell_id",
    "requested_by",
    "authorization_version",
    "correlation_id",
    "idempotency_key",
    "input_refs",
    "required_engine_release",
    "budgets",
    "created_at"
  ],
  "properties": {
    "job_id": { "type": "string", "format": "uuid" },
    "job_kind": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "company_id": { "type": "string", "format": "uuid" },
    "cell_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "requested_by": { "type": "string", "format": "uuid" },
    "authorization_version": { "type": "integer", "minimum": 0 },
    "correlation_id": { "type": "string", "format": "uuid" },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 256 },
    "input_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "id", "version", "sha256"],
        "properties": {
          "kind": { "type": "string", "maxLength": 64 },
          "id": { "type": "string", "maxLength": 256 },
          "version": { "type": "string", "maxLength": 256 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "required_engine_release": { "type": "string", "maxLength": 128 },
    "deadline": { "type": "string", "format": "date-time" },
    "priority": { "type": "integer", "minimum": 0, "maximum": 9 },
    "budgets": {
      "type": "object",
      "required": ["max_attempts", "max_seconds", "max_cost_units"],
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 20 },
        "max_seconds": { "type": "integer", "minimum": 1 },
        "max_cost_units": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "output_schema": { "type": "string", "format": "uri-reference" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}

