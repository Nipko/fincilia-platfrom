  "principles": [
    {
      "id": "QS-NO-AVERAGE",
      "rule": "Un promedio de cobertura nunca sustituye la enumeracion de campos, empresas o formatos fallidos."
    },
    {
      "id": "QS-FAIL-CLOSED",
      "rule": "Skip, quarantine, retry o waiver fallan cerrado en controles financieros y de seguridad."
    },
    {
      "id": "QS-EVIDENCE-OR-NOTHING",
      "rule": "Un test solo cuenta como evidencia si registra comando, version, hash, clasificacion y resultado."
    },
    {
      "id": "QS-DYNAMIC-IDS",
      "rule": "Los IDs requeridos se descubren de contratos ejecutables y catalogo; una lista fija paralela es drift disfrazado de cobertura."
    },
    {
      "id": "QS-DOUBLE-LIMITS",
      "rule": "Un mock demuestra que el llamador compila contra una firma, no que la dependencia real se comporte asi."
    },
    {
      "id": "QS-STRUCTURAL-NOT-SEMANTIC",
      "rule": "Cobertura estructural no es exactitud contable ni calidad de modelo."
    },
    {
      "id": "QS-ADJUDICATION-SOD",
      "rule": "Quien cambia el codigo no aprueba el expected output que ese cambio modifica."
    },
    {
      "id": "QS-NO-INVENTED-THRESHOLD",
      "rule": "Un umbral de rendimiento sin presupuesto aprobado permanece pending_human, no se inventa."
    },
    {
      "id": "QS-SYNTHETIC-ONLY",
      "rule": "Todo fixture es inequivocamente sintetico, inventariado y con procedencia demostrable."
    },
    {
      "id": "QS-OFFLINE",
      "rule": "Una prueba con red o reloj no controlado no es determinista y no es evidencia."
    }
  ],
