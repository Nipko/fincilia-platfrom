  "layers": [
    {
      "cannot_prove": "aislamiento de base de datos, RLS, concurrencia real o integracion",
      "gate": "S1-READY",
      "id": "unit",
      "proves": "que una transformacion respeta su contrato aislado",
      "scope": "funciones puras e invariantes locales",
      "test_doubles_allowed": true
    },
    {
      "cannot_prove": "que el espacio generado represente el trafico real",
      "gate": "S1-READY",
      "id": "property",
      "proves": "que una invariante se sostiene sobre un espacio generado",
      "scope": "dinero, fechas, locales, idempotencia y combinaciones",
      "test_doubles_allowed": true
    },
    {
      "cannot_prove": "que el codigo productivo implemente el contrato",
      "gate": "S1-READY",
      "id": "contract",
      "proves": "que dos contratos son mutuamente coherentes",
      "scope": "modelos ejecutables, OpenAPI, eventos, jobs y conectores",
      "test_doubles_allowed": false
    },
    {
      "cannot_prove": "correccion contable ni completitud de una fuente",
      "gate": "DRG-01",
      "id": "integration",
      "proves": "comportamiento real de la frontera con infraestructura",
      "scope": "PostgreSQL, RLS, object storage, outbox y workers",
      "test_doubles_allowed": false
    },
    {
      "cannot_prove": "que la salida adjudicada sea contablemente correcta",
      "gate": "S1-READY",
      "id": "golden",
      "proves": "que una salida adjudicada no cambio sin decision humana",
      "scope": "parsers, plantillas, engine_release y validadores adjudicados",
      "test_doubles_allowed": false
    },
    {
      "cannot_prove": "ausencia de vulnerabilidades no modeladas",
      "gate": "DRG-01",
      "id": "security",
      "proves": "que un ataque conocido falla cerrado",
      "scope": "cross-company, pool leakage, replay, worker escape, egress y restore",
      "test_doubles_allowed": false
    },
    {
      "cannot_prove": "rendimiento, escala ni exactitud financiera",
      "gate": "DRG-01",
      "id": "e2e",
      "proves": "que las piezas se conectan sobre datos sinteticos",
      "scope": "walking skeleton sintetico de extremo a extremo",
      "test_doubles_allowed": false
    },
    {
      "cannot_prove": "usabilidad percibida sin prueba con personas",
      "gate": "GA-01",
      "id": "usability_accessibility",
      "proves": "conformidad verificable de criterios automatizables",
      "scope": "teclado, foco, encabezados, contraste y flujo",
      "test_doubles_allowed": false
    }
  ],
  "mutation_policy": {
    "evidence_required": true,
    "minimum_mutants_per_validator": 5,
    "note": "Una suite en verde no demuestra que el validador muerda; una mutacion que sobrevive es un test que falta.",
    "required": true,
    "scope": "reglas criticas de cada validador ejecutable",
    "surviving_mutant_effect": "treated_as_missing_test"
  },
