{
  "active_environment": "local",
  "environments": [
    {
      "data_ceiling": "synthetic_only",
      "enabled": true,
      "id": "local",
      "network": "loopback_and_internal_compose",
      "secret_provider": "local_untracked_env"
    },
    {
      "data_ceiling": "synthetic_only",
      "enabled": true,
      "id": "ci",
      "network": "job_scoped",
      "secret_provider": "ephemeral_ci_only"
    },
    {
      "data_ceiling": "none_until_A02_L01",
      "enabled": false,
      "id": "staging",
      "network": "deny_by_default",
      "secret_provider": "pending_cloud_decision"
    },
    {
      "data_ceiling": "none_until_DRG01",
      "enabled": false,
      "id": "production",
      "network": "deny_by_default",
      "secret_provider": "pending_cloud_decision"
    }
  ],
  "external_ai_enabled": false,
  "forbidden_in_config": [
    "bank_username",
    "bank_password",
    "otp",
    "dian_password",
    "dian_certificate",
    "pan",
    "cvv",
    "customer_document",
    "raw_financial_payload",
    "cloud_access_key"
  ],
  "gates": [
    {
      "id": "CFG-G01",
      "rule": "cloud_secret_provider_selected_after_A02",
      "state": "not_met"
    },
    {
      "id": "CFG-G02",
      "rule": "production_config_reviewed_by_security",
      "state": "not_met"
    },
    {
      "id": "CFG-G03",
      "rule": "rotation_and_break_glass_tested",
      "state": "not_met"
    }
  ],
  "load_order": [
    "compiled_safe_defaults",
    "environment_file_untracked_local_only",
    "secret_provider_reference",
    "runtime_policy_validation"
  ],
  "production_enabled": false,
  "real_data_enabled": false,
  "schema_version": "1.0.0",
  "status": "review_pending",
  "task": "FNC-CFG-001",
