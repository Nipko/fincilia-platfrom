  "unresolved_decisions": [
    {
      "id": "UD-PLT-CLI-CI",
      "question": "Si CI debe invocar esta CLI en vez de enumerar comandos, y quien mantiene entonces la equivalencia",
      "owner_role": "Platform"
    },
    {
      "id": "UD-PLT-CLI-EXPECTED",
      "question": "Cadencia de revision de los `expected_today`: un fallo previsto que nadie revisa se vuelve ruido aceptado",
      "owner_role": "QA"
    }
  ],
  "resolved_decisions": [
    {
      "id": "UD-PLT-CLI-WSL",
      "task_id": "FNC-PLT-009",
      "decision": "La CLI Python permanece portable y sin cruce implicito. En Windows, un wrapper PowerShell dedicado y contractualmente allowlisted mantiene una sesion WSL oculta y ejecuta el lifecycle fijo de fincilia-local.",
      "accountable_owner": "FOUNDER-01"
    }
  ],
  "anti_promises": [
    "Un `doctor` en verde dice que las herramientas responden, no que el repositorio este correcto.",
    "Esta CLI no es autoridad sobre ningun gate, estado ni decision: solo lee y ejecuta lo que otros contratos declaran.",
    "No instala, no actualiza, no purga, no resetea, no siembra datos y no migra nada de producto.",
    "`stack down` no borra volumenes: si alguien esperaba que dejara la base limpia, no lo hace a proposito.",
    "Un `expected_today` explica por que un fallo ya se conocia; no lo convierte en aprobado y no altera el exit code.",
    "No lee ni imprime `.env`, entorno completo ni rutas de usuario innecesarias."
  ]
}
