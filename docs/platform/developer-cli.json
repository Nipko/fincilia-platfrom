{
  "schema_version": 1,
  "task_id": "FNC-PLT-007",
  "status": "review_pending",
  "human_acceptance": "pending",
  "data_ceiling": "synthetic_only",
  "writes_gate_or_status": false,
  "installs_or_updates_dependencies": false,
  "aggregate_score_as_gate": false,
  "purpose": "Reducir comandos manuales componiendo contratos que ya existen, sin crear una segunda fuente de verdad sobre gates, estados o secretos.",
  "non_goals": [
    "instalar o actualizar dependencias",
    "purgar, resetear o sembrar datos",
    "ejecutar migraciones de producto",
    "tocar cloud, secretos o configuracion",
    "decidir el estado de ningun gate"
  ],
  "exit_codes": {
    "ok": 0,
    "check_failed": 1,
    "invalid_usage": 2,
    "dependency_missing": 3,
    "timeout": 4
  },
  "environment_policy": {
    "env_allowlist": [
      "PATH",
      "SYSTEMROOT",
      "COMSPEC",
      "TEMP",
      "TMP",
      "HOME",
      "USERPROFILE",
      "LANG",
      "LC_ALL"
    ],
    "inherits_proxies": false,
    "inherits_tokens": false,
    "inherits_credentials": false,
    "shell": false,
    "note": "El allowlist se filtra otra vez en codigo contra PROXY, TOKEN, SECRET, KEY, PASSWORD y CREDENTIAL, de modo que ampliarlo por descuido en el contrato no basta para filtrar nada."
  },
  "stack": {
    "compose_project": "fincilia-local",
    "compose_file": "infra/local/compose.yaml",
    "cwd": ".",
    "timeout_seconds": 300,
    "removes_volumes": false,
    "removes_orphans": false,
    "purges_data": false,
    "seeds_real_data": false,
    "runs_product_migrations": false,
    "lock_required": true,
    "note": "`down` es deliberadamente `docker compose down` a secas. Anadir --volumes borraria el volumen local con nombre, y --remove-orphans puede tocar contenedores que otro proyecto dejo colgando."
  },
  "degradation": {
    "doctor_requires_docker": false,
    "missing_tool_is_diagnosis_not_traceback": true,
    "note": "doctor, validate y test funcionan sin Docker. Solo `stack` lo necesita, y si falta devuelve un diagnostico estable con exit dependency_missing."
  },
  "dependencies": [
    {
      "id": "docker_cli",
      "kind": "external_binary",
      "required": false,
      "probe_argv": [
        "docker",
        "--version"
      ],
      "timeout_seconds": 30,
      "diagnosis": "El binario `docker` no responde en el PATH de este proceso. Si Docker vive dentro de WSL, ejecuta esta CLI desde WSL: no se atraviesa el limite por ti para no construir un comando que nadie declaro."
    },
    {
      "id": "docker_daemon",
      "kind": "external_daemon",
      "required": false,
      "probe_argv": [
        "docker",
        "version",
        "--format",
        "{{.Server.Version}}"
      ],
      "timeout_seconds": 30,
      "diagnosis": "El demonio de Docker no responde. `doctor`, `validate` y `test` siguen funcionando; solo `stack` queda bloqueado."
    },
    {
      "id": "docker_compose",
      "kind": "external_plugin",
      "required": false,
      "probe_argv": [
        "docker",
        "compose",
        "version"
      ],
      "timeout_seconds": 30,
      "diagnosis": "El plugin `docker compose` no responde. Sin el no se puede operar el stack local."
    }
  ],
