{
  "name": "@fincilia/web",
  "version": "0.1.0",
  "private": true,
  "description": "Interfaz local de Fincilia. Nunca decide autorizacion ni estado financiero.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
